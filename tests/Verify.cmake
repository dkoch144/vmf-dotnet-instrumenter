function(run)
    execute_process(COMMAND ${ARGV} RESULT_VARIABLE status)
    if(NOT status EQUAL 0)
        message(FATAL_ERROR "Command failed: ${ARGV}")
    endif()
endfunction()

set(source "${CMAKE_CURRENT_LIST_DIR}/..")
run("${DOTNET}" build "${source}/src/Instrumenter" --artifacts-path "${OUTPUT}/artifacts"
    --output "${OUTPUT}/tool")
run("${DOTNET}" build "${source}/tests/Fixture" --artifacts-path "${OUTPUT}/artifacts"
    --output "${OUTPUT}/original")
file(MAKE_DIRECTORY "${OUTPUT}/staged")
file(COPY "${OUTPUT}/original/" DESTINATION "${OUTPUT}/staged")
file(SHA256 "${OUTPUT}/original/Target.dll" before)
file(SHA256 "${OUTPUT}/staged/Fixture.dll" harnessBefore)
run("${DOTNET}" "${OUTPUT}/tool/Instrumenter.dll" "${OUTPUT}/staged/Target.dll")
file(SHA256 "${OUTPUT}/original/Target.dll" after)
file(SHA256 "${OUTPUT}/staged/Fixture.dll" harnessAfter)
if(NOT harnessBefore STREQUAL harnessAfter)
    message(FATAL_ERROR "Unselected harness changed")
endif()
if(NOT before STREQUAL after)
    message(FATAL_ERROR "Original fixture changed")
endif()

function(check input label expected)
    file(WRITE "${OUTPUT}/testcase" "${input}")
    file(REMOVE "${OUTPUT}/${label}.map")
    execute_process(COMMAND "${DOTNET}" "${OUTPUT}/staged/Fixture.dll" "${OUTPUT}/${label}.map"
        INPUT_FILE "${OUTPUT}/testcase" OUTPUT_VARIABLE actual OUTPUT_STRIP_TRAILING_WHITESPACE
        RESULT_VARIABLE status)
    if(NOT status EQUAL 0 OR NOT actual STREQUAL expected)
        message(FATAL_ERROR "Fixture behavior changed: ${status}, ${actual}")
    endif()
    file(SIZE "${OUTPUT}/${label}.map" size)
    if(NOT size EQUAL 65536)
        message(FATAL_ERROR "Unexpected coverage map size: ${size}")
    endif()
    file(SHA256 "${OUTPUT}/${label}.map" hash)
    set("${label}" "${hash}" PARENT_SCOPE)
endfunction()

check("A" first "first")
check("B" second "second")
check("A" repeated "first")
if(first STREQUAL second OR NOT first STREQUAL repeated)
    message(FATAL_ERROR "Coverage must distinguish branches and repeat across processes")
endif()
